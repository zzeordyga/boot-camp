rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    match /users/{userId} {
      // A user can read their own profile; an admin can read anyone's.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // A user can only create their OWN profile doc, and it must start as "user".
      // This stops someone from registering and self-assigning "admin" via the client.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'user';

      // A user may update their own doc, but may never change their own role.
      // Only an admin (editing via console/backend) can change the role field.
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // Example admin-only collection to demonstrate role-gated data.
    match /adminData/{docId} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
